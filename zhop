-- ================ ПОЛУЧЕНИЕ КОМАНДЫ ИГРОКА ================
local function getPlayerTeam(player)
	local status = player:FindFirstChild("Status")
	if status then
		local team = status:FindFirstChild("Team")
		if team then
			return team.Value
		end
	end
	return nil
end

local function isEnemy(player)
	if player == Player then return false end
	local myTeam = getPlayerTeam(Player)
	local theirTeam = getPlayerTeam(player)
	
	if myTeam and theirTeam then
		return myTeam ~= theirTeam
	end
	return true
end

-- ================ УМНАЯ ПРОВЕРКА ВИДИМОСТИ ================
local function canSeePart(part)
	if not part or not Camera then return false end
	
	local rayOrigin = Camera.CFrame.Position
	local direction = (part.Position - rayOrigin)
	local distance = direction.Magnitude
	
	if distance > 3000 then return false end
	
	local rayDirection = direction.Unit * distance
	
	local filterList = {}
	
	if Character then
		for _, v in pairs(Character:GetDescendants()) do
			if v:IsA("BasePart") then
				table.insert(filterList, v)
			end
		end
	end
	
	if part.Parent then
		for _, v in pairs(part.Parent:GetDescendants()) do
			if v:IsA("BasePart") then
				table.insert(filterList, v)
			end
		end
	end
	
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
	raycastParams.FilterDescendantsInstances = filterList
	raycastParams.IgnoreWater = true
	
	local raycastResult = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
	
	if not raycastResult then
		return true
	end
	
	local hitPart = raycastResult.Instance
	if hitPart then
		if part.Parent and hitPart:IsDescendantOf(part.Parent) then
			return true
		end
		
		local hitDistance = (raycastResult.Position - rayOrigin).Magnitude
		if hitDistance > distance then
			return true
		end
	end
	
	return false
end

-- ================ УМНЫЙ ВЫБОР ЧАСТИ ТЕЛА ================
local function getSmartTargetPart(character)
	if not character then return nil end
	
	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return nil end
	
	-- Собираем все части тела
	local bodyParts = {
		Head = character:FindFirstChild("Head"),
		UpperTorso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"),
		LowerTorso = character:FindFirstChild("LowerTorso"),
		LeftArm = character:FindFirstChild("LeftArm") or character:FindFirstChild("LeftUpperArm"),
		RightArm = character:FindFirstChild("RightArm") or character:FindFirstChild("RightUpperArm"),
		LeftLeg = character:FindFirstChild("LeftLeg") or character:FindFirstChild("LeftUpperLeg"),
		RightLeg = character:FindFirstChild("RightLeg") or character:FindFirstChild("RightUpperLeg"),
		HumanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	}
	
	-- Проверяем видимость каждой части
	local visibleParts = {}
	for name, part in pairs(bodyParts) do
		if part and canSeePart(part) then
			table.insert(visibleParts, {name = name, part = part, priority = 0})
		end
	end
	
	if #visibleParts == 0 then return nil end
	
	-- Устанавливаем приоритеты
	for _, v in ipairs(visibleParts) do
		if v.name == "Head" then
			v.priority = 4 -- Высший приоритет
		elseif v.name == "UpperTorso" or v.name == "HumanoidRootPart" then
			v.priority = 3 -- Высокий приоритет
		elseif v.name == "LowerTorso" then
			v.priority = 2 -- Средний приоритет
		elseif v.name == "LeftArm" or v.name == "RightArm" then
			v.priority = 1 -- Низкий приоритет
		elseif v.name == "LeftLeg" or v.name == "RightLeg" then
			v.priority = 0 -- Самый низкий приоритет
		end
	end
	
	-- Логика выбора
	local headVisible = false
	local torsoVisible = false
	local armsVisible = false
	local legsVisible = false
	
	for _, v in ipairs(visibleParts) do
		if v.name == "Head" then headVisible = true end
		if v.name == "UpperTorso" or v.name == "LowerTorso" or v.name == "HumanoidRootPart" then torsoVisible = true end
		if v.name == "LeftArm" or v.name == "RightArm" then armsVisible = true end
		if v.name == "LeftLeg" or v.name == "RightLeg" then legsVisible = true end
	end
	
	-- Выбираем цель в зависимости от видимости
	if headVisible and torsoVisible then
		-- Видим голову и тело - шанс 70% тело, 30% голова
		if math.random() < 0.7 then
			-- Выбираем тело
			for _, v in ipairs(visibleParts) do
				if v.name == "UpperTorso" or v.name == "HumanoidRootPart" then
					return v.part
				end
			end
		else
			-- Выбираем голову
			for _, v in ipairs(visibleParts) do
				if v.name == "Head" then
					return v.part
				end
			end
		end
	elseif headVisible and not torsoVisible then
		-- Видим только голову
		for _, v in ipairs(visibleParts) do
			if v.name == "Head" then
				return v.part
			end
		end
	elseif torsoVisible and not headVisible then
		-- Видим тело, но не голову
		if armsVisible and math.random() < 0.3 then
			-- 30% шанс стрелять в руки
			local arms = {}
			for _, v in ipairs(visibleParts) do
				if v.name == "LeftArm" or v.name == "RightArm" then
					table.insert(arms, v)
				end
			end
			if #arms > 0 then
				return arms[math.random(1, #arms)].part
			end
		end
		
		-- Иначе стреляем в тело
		for _, v in ipairs(visibleParts) do
			if v.name == "UpperTorso" or v.name == "LowerTorso" or v.name == "HumanoidRootPart" then
				return v.part
			end
		end
	elseif (armsVisible or legsVisible) and not torsoVisible and not headVisible then
		-- Видим только конечности
		local limbs = {}
		for _, v in ipairs(visibleParts) do
			if v.name == "LeftArm" or v.name == "RightArm" or v.name == "LeftLeg" or v.name == "RightLeg" then
				table.insert(limbs, v)
			end
		end
		
		if #limbs > 0 then
			-- Шанс 50/50 между руками и ногами
			if armsVisible and legsVisible then
				if math.random() < 0.5 then
					-- Выбираем руку
					local arms = {}
					for _, v in ipairs(limbs) do
						if v.name == "LeftArm" or v.name == "RightArm" then
							table.insert(arms, v)
						end
					end
					if #arms > 0 then
						return arms[math.random(1, #arms)].part
					end
				else
					-- Выбираем ногу
					local legs = {}
					for _, v in ipairs(limbs) do
						if v.name == "LeftLeg" or v.name == "RightLeg" then
							table.insert(legs, v)
						end
					end
					if #legs > 0 then
						return legs[math.random(1, #legs)].part
					end
				end
			else
				-- Только руки или только ноги
				return limbs[math.random(1, #limbs)].part
			end
		end
	end
	
	-- Если ничего не выбрали, возвращаем самую приоритетную часть
	table.sort(visibleParts, function(a, b) return a.priority > b.priority end)
	return visibleParts[1].part
end

-- ================ ФУНКЦИЯ ПОИСКА ВРАГА ================
local function findNearestEnemy()
	local nearestTarget = nil
	local nearestPart = nil
	local nearestDistance = math.huge
	local viewportSize = Camera.ViewportSize
	local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
	
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= Player and player.Character and isEnemy(player) then
			local targetHumanoid = player.Character:FindFirstChild("Humanoid")
			
			if targetHumanoid and targetHumanoid.Health > 0 then
				-- Получаем умную часть тела
				local targetPart = getSmartTargetPart(player.Character)
				
				if targetPart then
					local distance3D = (targetPart.Position - Camera.CFrame.Position).Magnitude
					if distance3D < 3000 then
						local screenPos, onScreen = Camera:WorldToScreenPoint(targetPart.Position)
						
						if onScreen then
							local screenPoint = Vector2.new(screenPos.X, screenPos.Y)
							local distance2D = (screenPoint - screenCenter).Magnitude
							
							if distance2D < aimFOV and distance2D < nearestDistance then
								nearestDistance = distance2D
								nearestTarget = player
								nearestPart = targetPart
							end
						end
					end
				end
			end
		end
	end
	
	return nearestTarget, nearestPart
end

-- ================ AIM FUNCTION ================
local function toggleAim(state)
	aimEnabled = state
	print("Aim: " .. (state and "Enabled" or "Disabled"))
end

local function aimAtTarget()
	if aimTarget and aimTarget.Character and aimPart then
		local targetHumanoid = aimTarget.Character:FindFirstChild("Humanoid")
		
		if targetHumanoid and targetHumanoid.Health > 0 and aimPart.Parent then
			if canSeePart(aimPart) then
				local targetPos = aimPart.Position
				
				-- Плавный аим
				if smoothness > 1 then
					local currentCF = Camera.CFrame
					local targetCF = CFrame.lookAt(currentCF.Position, targetPos)
					Camera.CFrame = currentCF:Lerp(targetCF, 1 / smoothness)
				else
					Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
				end
			else
				-- Если часть стала невидимой, ищем новую
				aimPart = getSmartTargetPart(aimTarget.Character)
				if not aimPart then
					aimTarget = nil
				end
			end
		else
			aimTarget = nil
			aimPart = nil
		end
	end
end

