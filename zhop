local espConnections = {}
local ePressed = false
local isShooting = false
local infiniteJumpEnabled = false
local triggerbotEnabled = false
local aimFOV = 500
local smoothness = 5 -- Плавность аима (1-20, где 1 = максимально плавно)

-- GUI VARIABLES
