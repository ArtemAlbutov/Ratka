-- ================ ИСПРАВЛЕННЫЙ ESP ================
local espGui = nil
local espBoxes = {}

local function toggleESP(state)
	espEnabled = state
	print("ESP: " .. (state and "Enabled" or "Disabled"))
	
	if state then
		if not espGui then
			espGui = Instance.new("ScreenGui")
			espGui.Name = "ESPGui"
			espGui.ResetOnSpawn = false
			espGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
			espGui.DisplayOrder = 999998
			espGui.IgnoreGuiInset = true
			espGui.Parent = Player:WaitForChild("PlayerGui")
		end
		
		espConnections.update = RunService.RenderStepped:Connect(function()
			local viewportSize = Camera.ViewportSize
			
			for _, player in pairs(Players:GetPlayers()) do
				if player ~= Player and player.Character then
					local humanoid = player.Character:FindFirstChild("Humanoid")
					local head = player.Character:FindFirstChild("Head")
					local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
					local lowerTorso = player.Character:FindFirstChild("LowerTorso") or player.Character:FindFirstChild("Torso")
					
					if humanoid and head and humanoid.Health > 0 and rootPart and lowerTorso then
						-- Исправленный расчет позиций для бокса
						local headPos = head.Position + Vector3.new(0, 0.5, 0) -- Немного выше головы
						local feetPos = lowerTorso.Position - Vector3.new(0, lowerTorso.Size.Y / 2 + 0.5, 0) -- Нижняя точка
						
						local headScreen, headOnScreen = Camera:WorldToScreenPoint(headPos)
						local feetScreen, feetOnScreen = Camera:WorldToScreenPoint(feetPos)
						
						if headOnScreen and feetOnScreen then
							-- Расширенные границы для отрисовки
							local margin = 100
							if headScreen.X >= -margin and headScreen.X <= viewportSize.X + margin and
							   headScreen.Y >= -margin and headScreen.Y <= viewportSize.Y + margin and
							   feetScreen.X >= -margin and feetScreen.X <= viewportSize.X + margin and
							   feetScreen.Y >= -margin and feetScreen.Y <= viewportSize.Y + margin then
								
								local height = math.abs(headScreen.Y - feetScreen.Y)
								local width = height * 0.5 -- Немного шире для лучшей видимости
								
								if height > 10 and height < viewportSize.Y * 2 and width > 5 then
									local boxX = (headScreen.X + feetScreen.X) / 2 - width / 2
									local boxY = math.min(headScreen.Y, feetScreen.Y)
									
									local boxColor
									if isEnemy(player) then
										boxColor = Color3.fromRGB(255, 50, 50) -- Ярче красный для врагов
									else
										boxColor = Color3.fromRGB(50, 255, 50) -- Ярче зеленый для союзников
									end
									
									-- Добавляем поле здоровья
									local healthPercent = humanoid.Health / humanoid.MaxHealth
									local healthColor = Color3.fromRGB(255, 255, 255)
									if healthPercent > 0.6 then
										healthColor = Color3.fromRGB(50, 255, 50)
									elseif healthPercent > 0.3 then
										healthColor = Color3.fromRGB(255, 255, 50)
									else
										healthColor = Color3.fromRGB(255, 50, 50)
									end
									
									local boxData = espBoxes[player.UserId]
									if not boxData then
										local boxContainer = Instance.new("Frame")
										boxContainer.BackgroundTransparency = 1
										boxContainer.ZIndex = 10
										boxContainer.Parent = espGui
										
										local lines = {}
										for i = 1, 4 do
											local line = Instance.new("Frame")
											line.BackgroundColor3 = boxColor
											line.BorderSizePixel = 0
											line.ZIndex = 11
											line.Parent = boxContainer
											lines[i] = line
										end
										
										local nameLabel = Instance.new("TextLabel")
										nameLabel.BackgroundTransparency = 1
										nameLabel.TextColor3 = boxColor
										nameLabel.Font = Enum.Font.GothamBold
										nameLabel.TextSize = 13
										nameLabel.TextStrokeTransparency = 0.7
										nameLabel.ZIndex = 12
										nameLabel.Parent = boxContainer
										
										local healthBar = Instance.new("Frame")
										healthBar.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
										healthBar.BorderSizePixel = 0
										healthBar.ZIndex = 12
										healthBar.Parent = boxContainer
										
										local healthFill = Instance.new("Frame")
										healthFill.BackgroundColor3 = healthColor
										healthFill.BorderSizePixel = 0
										healthFill.ZIndex = 13
										healthFill.Parent = healthBar
										
										boxData = {
											container = boxContainer,
											lines = lines,
											nameLabel = nameLabel,
											healthBar = healthBar,
											healthFill = healthFill
										}
										espBoxes[player.UserId] = boxData
									end
									
									for _, line in pairs(boxData.lines) do
										line.BackgroundColor3 = boxColor
									end
									boxData.nameLabel.TextColor3 = boxColor
									
									boxData.container.Size = UDim2.new(0, width + 6, 0, height + 6)
									boxData.container.Position = UDim2.new(0, boxX - 3, 0, boxY - 3)
									boxData.container.Visible = true
									
									-- Линии бокса
									boxData.lines[1].Size = UDim2.new(1, 0, 0, 2)
									boxData.lines[1].Position = UDim2.new(0, 0, 0, 0)
									
									boxData.lines[2].Size = UDim2.new(1, 0, 0, 2)
									boxData.lines[2].Position = UDim2.new(0, 0, 1, -2)
									
									boxData.lines[3].Size = UDim2.new(0, 2, 1, 0)
									boxData.lines[3].Position = UDim2.new(0, 0, 0, 0)
									
									boxData.lines[4].Size = UDim2.new(0, 2, 1, 0)
									boxData.lines[4].Position = UDim2.new(1, -2, 0, 0)
									
									-- Имя и здоровье
									boxData.nameLabel.Size = UDim2.new(0, width + 30, 0, 18)
									boxData.nameLabel.Position = UDim2.new(0.5, -(width + 30) / 2, 0, -22)
									boxData.nameLabel.Text = player.Name .. " [" .. math.floor(humanoid.Health) .. " HP]"
									boxData.nameLabel.Visible = true
									
									-- Полоса здоровья
									boxData.healthBar.Size = UDim2.new(0, 2, 1, 0)
									boxData.healthBar.Position = UDim2.new(1, 2, 0, 0)
									boxData.healthBar.Visible = true
									
									boxData.healthFill.Size = UDim2.new(1, 0, healthPercent, 0)
									boxData.healthFill.Position = UDim2.new(0, 0, 1 - healthPercent, 0)
									boxData.healthFill.BackgroundColor3 = healthColor
								else
									if espBoxes[player.UserId] then
										espBoxes[player.UserId].container.Visible = false
									end
								end
							else
								if espBoxes[player.UserId] then
									espBoxes[player.UserId].container.Visible = false
								end
							end
						else
							if espBoxes[player.UserId] then
								espBoxes[player.UserId].container.Visible = false
							end
						end
					else
						if espBoxes[player.UserId] then
							espBoxes[player.UserId].container.Visible = false
						end
					end
				else
					if espBoxes[player.UserId] then
						espBoxes[player.UserId].container.Visible = false
					end
				end
			end
		end)
	else
		if espConnections.update then
			espConnections.update:Disconnect()
			espConnections.update = nil
		end
		
		for userId, boxData in pairs(espBoxes) do
			pcall(function() 
				boxData.container:Destroy()
			end)
		end
		espBoxes = {}
		
		if espGui then
			espGui:Destroy()
			espGui = nil
		end
	end
end

-- ================ FOV FUNCTION ================
local fovEnabled = false
local fovValue = 70
local fovConnection = nil

local function setFOV(value)
	fovValue = math.clamp(value, 1, 120)
	if fovEnabled then
		print("FOV: " .. fovValue)
	end
end

local function toggleFOV(state)
	fovEnabled = state
	print("FOV: " .. (state and "Enabled" or "Disabled"))
	
	if state then
		fovConnection = RunService.RenderStepped:Connect(function()
			if fovEnabled and Workspace.CurrentCamera then
				Workspace.CurrentCamera.FieldOfView = fovValue
			end
		end)
	else
		if fovConnection then
			fovConnection:Disconnect()
			fovConnection = nil
		end
		if Workspace.CurrentCamera then
			Workspace.CurrentCamera.FieldOfView = 70
		end
	end
end

-- ================ INPUT HANDLERS ================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	-- Infinite Jump
	if input.KeyCode == Enum.KeyCode.Space and infiniteJumpEnabled and Humanoid then
		Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
	
	-- Aim (держим E)
	if input.KeyCode == Enum.KeyCode.E then
		ePressed = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.E then
		ePressed = false
		if isShooting then
			isShooting = false
			pcall(function()
				VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
			end)
		end
		aimTarget = nil
		aimPart = nil
	end
end)

-- ================ MAIN LOOP (AIM + TRIGGERBOT) ================
RunService.RenderStepped:Connect(function()
	-- AIM
	if aimEnabled and ePressed then
		if aimTarget and aimTarget.Character and aimPart then
			local targetHumanoid = aimTarget.Character:FindFirstChild("Humanoid")
			if targetHumanoid and targetHumanoid.Health > 0 and aimPart.Parent then
				aimAtTarget()
			else
				aimTarget = nil
				aimPart = nil
			end
		else
			aimTarget, aimPart = findNearestEnemy()
		end
	end
	
	-- TRIGGERBOT
	if triggerbotEnabled and aimEnabled and ePressed then
		if aimTarget and aimTarget.Character and aimPart then
			local targetHumanoid = aimTarget.Character:FindFirstChild("Humanoid")
			
			if targetHumanoid and targetHumanoid.Health > 0 and aimPart.Parent then
				if canSeePart(aimPart) and isEnemy(aimTarget) then
					local screenPos, onScreen = Camera:WorldToScreenPoint(aimPart.Position)
					
					if onScreen then
						local viewportSize = Camera.ViewportSize
						local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
						local screenPoint = Vector2.new(screenPos.X, screenPos.Y)
						local distance = (screenPoint - screenCenter).Magnitude
						
						-- Увеличиваем радиус срабатывания для разных частей тела
						local triggerRadius = 100
						if aimPart.Name == "Head" then
							triggerRadius = 80 -- Меньше радиус для головы (точнее)
						elseif aimPart.Name == "UpperTorso" or aimPart.Name == "LowerTorso" or aimPart.Name == "HumanoidRootPart" then
							triggerRadius = 120 -- Больше радиус для тела
						end
						
						if distance < triggerRadius then
							if not isShooting then
								isShooting = true
								pcall(function()
									VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
								end)
							end
						else
							if isShooting then
								isShooting = false
								pcall(function()
									VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
								end)
							end
						end
					else
						if isShooting then
							isShooting = false
							pcall(function()
								VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
							end)
						end
					end
				else
					if isShooting then
						isShooting = false
						pcall(function()
							VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
						end)
					end
				end
			else
				if isShooting then
					isShooting = false
					pcall(function()
						VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
					end)
				end
				aimTarget = nil
				aimPart = nil
			end
		else
			if isShooting then
				isShooting = false
				pcall(function()
					VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
				end)
			end
			aimTarget = nil
			aimPart = nil
		end
	end
end)

-- ================ CHARACTER HANDLING ================
Player.CharacterAdded:Connect(function(char)
	Character = char
	Humanoid = char:WaitForChild("Humanoid")
