-- // Перетаскивание окна
local dragging = false
local dragStart = nil
local startPos = nil

TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- // Переключение видимости клавишей Insert
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.Insert then
		MainFrame.Visible = not MainFrame.Visible
	end
end)

-- // ESP СИСТЕМА

-- Состояние ESP
local espEnabled = false
local highlightContainer = Instance.new("Folder")
highlightContainer.Name = "ESP_Highlights"
highlightContainer.Parent = playerGui

-- Функция получения роли игрока
local function getPlayerRole(targetPlayer)
	local character = targetPlayer.Character
	if not character then
		return nil, nil
	end
	
	local hasKnife = false
	local hasDodge = false
	
	-- Проверка в руках (Character)
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			if child.Name == "Knife" or child.Name == "Fists" then
				hasKnife = true
			elseif child.Name == "DODGE!" then
				hasDodge = true
			end
		end
	end
	
	-- Проверка в инвентаре (Backpack)
	local backpack = targetPlayer:FindFirstChild("Backpack")
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if child:IsA("Tool") then
				if child.Name == "Knife" then
					hasKnife = true
				elseif child.Name == "DODGE!" then
					hasDodge = true
				end
			end
		end
	end
	
	-- ПРИОРИТЕТ: Сначала проверяем DODGE!
	if hasDodge then
		return "HIDER", Color3.fromRGB(0, 255, 0)  -- Зеленый
	elseif hasKnife then
		return "SEEKER", Color3.fromRGB(255, 0, 0)  -- Красный
	else
		return "PLAYER", Color3.fromRGB(255, 255, 255)  -- Белый
	end
end

-- Функция обновления ESP
local function updateESP()
	-- Очистка старых подсветок
	highlightContainer:ClearAllChildren()
	
	if not espEnabled then
		return
	end
	
	-- Обновление для каждого игрока
	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= player and targetPlayer.Character then
			local character = targetPlayer.Character
			local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
			local head = character:FindFirstChild("Head")
			
			if humanoidRootPart and head then
				local role, color = getPlayerRole(targetPlayer)
				
				if role and color then
					-- Создание Highlight
					local highlight = Instance.new("Highlight")
					highlight.Name = targetPlayer.Name
					highlight.Adornee = character
					highlight.FillColor = color
					highlight.OutlineColor = color
					highlight.FillTransparency = 0.5
					highlight.OutlineTransparency = 0
					highlight.Enabled = true
					highlight.Parent = highlightContainer
					
					-- Создание BillboardGui для текста
					local billboard = Instance.new("BillboardGui")
					billboard.Name = targetPlayer.Name .. "_Label"
					billboard.Adornee = head
					billboard.Size = UDim2.new(0, 200, 0, 50)
					billboard.StudsOffset = Vector3.new(0, 2.5, 0)
					billboard.AlwaysOnTop = true
					billboard.Parent = highlightContainer
					
					-- Текстовое поле
					local textLabel = Instance.new("TextLabel")
					textLabel.Size = UDim2.new(1, 0, 1, 0)
					textLabel.BackgroundTransparency = 1
					textLabel.Text = targetPlayer.Name .. "\n[" .. role .. "]"
					textLabel.TextColor3 = color
					textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
					textLabel.TextStrokeTransparency = 0
					textLabel.Font = Enum.Font.GothamBold
					textLabel.TextSize = 16
					textLabel.Parent = billboard
				end
			end
		end
	end
end

-- Подключение к RenderStepped для постоянного обновления
RunService.RenderStepped:Connect(function()
	updateESP()
end)

