-- // Функция создания переключателя
local function CreateToggle(name: string, description: string, default: boolean, callback: (boolean) -> ())
	local ToggleFrame = Instance.new("Frame")
	ToggleFrame.Name = name .. "_Toggle"
	ToggleFrame.Size = UDim2.new(1, -16, 0, 50)
	ToggleFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	ToggleFrame.BorderSizePixel = 0
	ToggleFrame.LayoutOrder = 1
	ToggleFrame.Parent = ScrollingFrame

	-- Название функции
	local FuncName = Instance.new("TextLabel")
	FuncName.Name = "FuncName"
	FuncName.Size = UDim2.new(1, -60, 0, 20)
	FuncName.Position = UDim2.new(0, 8, 0, 5)
	FuncName.BackgroundTransparency = 1
	FuncName.Text = name
	FuncName.TextColor3 = Color3.fromRGB(220, 220, 220)
	FuncName.TextXAlignment = Enum.TextXAlignment.Left
	FuncName.Font = Enum.Font.GothamSemibold
	FuncName.TextSize = 14
	FuncName.Parent = ToggleFrame

	-- Описание функции
	local FuncDesc = Instance.new("TextLabel")
	FuncDesc.Name = "FuncDesc"
	FuncDesc.Size = UDim2.new(1, -60, 0, 18)
	FuncDesc.Position = UDim2.new(0, 8, 0, 26)
	FuncDesc.BackgroundTransparency = 1
	FuncDesc.Text = description
	FuncDesc.TextColor3 = Color3.fromRGB(140, 140, 140)
	FuncDesc.TextXAlignment = Enum.TextXAlignment.Left
	FuncDesc.Font = Enum.Font.Gotham
	FuncDesc.TextSize = 11
	FuncDesc.TextWrapped = true
	FuncDesc.Parent = ToggleFrame

	-- Кнопка переключателя
	local ToggleButton = Instance.new("TextButton")
	ToggleButton.Name = "ToggleButton"
	ToggleButton.Size = UDim2.new(0, 36, 0, 18)
	ToggleButton.Position = UDim2.new(1, -44, 0.5, -9)
	ToggleButton.BackgroundColor3 = default and Color3.fromRGB(70, 150, 70) or Color3.fromRGB(70, 70, 70)
	ToggleButton.BorderSizePixel = 0
	ToggleButton.Text = ""
	ToggleButton.AutoButtonColor = false
	ToggleButton.Parent = ToggleFrame

	-- Ползунок внутри переключателя
	local Slider = Instance.new("Frame")
	Slider.Name = "Slider"
	Slider.Size = UDim2.new(0, 14, 0, 14)
	Slider.Position = default and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
	Slider.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
	Slider.BorderSizePixel = 0
	Slider.Parent = ToggleButton

	local isToggled = default

	local function updateVisual()
		if isToggled then
			ToggleButton.BackgroundColor3 = Color3.fromRGB(70, 150, 70)
			Slider:TweenPosition(UDim2.new(1, -16, 0.5, -7), "Out", "Quad", 0.1)
		else
			ToggleButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
			Slider:TweenPosition(UDim2.new(0, 2, 0.5, -7), "Out", "Quad", 0.1)
		end
	end

	ToggleButton.MouseButton1Click:Connect(function()
		isToggled = not isToggled
		updateVisual()
		callback(isToggled)
	end)
end

